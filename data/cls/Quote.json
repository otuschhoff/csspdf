{
  "subDir": "angebot",
  "regex": "^(?<year>20[1-5]\d)(?<month>0\d|1[012])-(?<subId>A\d+)$",
  "map": {
    "date"       :{ "attr": "datum"       },
    "start"      :{ "attr": "start"       },
    "end"        :{ "attr": "ende"        },
    "hourlyRate" :{ "attr": "stundenSatz" },
    "hours"      :{ "attr": "stunden"     },
    "customer"   :{ "attr": "kunde"       }
  }
}
